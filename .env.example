# Copie para .env.local (no computador) ou cadastre estas variáveis no painel da Vercel. NUNCA coloque valores neste arquivo.

# URL do projeto Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (anon / publishable). Pode ficar no navegador; quem protege os dados é o RLS no banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (service_role / secret). SECRETA: só no servidor, nunca com prefixo NEXT_PUBLIC_.
# Usada somente para apagar o login quando o usuário exclui a própria conta.
SUPABASE_SERVICE_ROLE_KEY=
